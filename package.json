{
  "name": "ai-memories-studio",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm run dev -w @memories/api\" \"npm run dev -w @memories/web\"",
    "build": "npm run build -w @memories/shared && npm run build -w @memories/api && npm run build -w @memories/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build -w @memories/shared",
    "predev": "npm run build -w @memories/shared",
    "pretest": "npm run build -w @memories/shared",
    "pretypecheck": "npm run build -w @memories/shared",
    "test:movie": "tsx apps/api/scripts/p5-synthetic.ts",
    "test:production": "tsx apps/api/scripts/p6-synthetic.ts",
    "test:cinematic": "tsx apps/api/scripts/p61-synthetic.ts",
    "test:storytelling": "tsx apps/api/scripts/storytelling-render-validation.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "~5.7.3",
    "vitest": "^5.1.0",
    "vite": "^6.4.6"
  }
}

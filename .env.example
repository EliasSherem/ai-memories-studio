# Copy to .env in the repository root. Never prefix server secrets with VITE_.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback
GOOGLE_PHOTOS_SCOPE=https://www.googleapis.com/auth/photospicker.mediaitems.readonly
WEB_ORIGIN=http://localhost:5173
API_PORT=3001
# Required: generate a random secret with the command in README.md (at least 32 characters).
SESSION_SECRET=
MEDIA_STORAGE_PATH=./data/imports

# SQLite contains private project metadata and encrypted temporary queue references.
DATABASE_PATH=./data/studio.sqlite
# Download concurrency applies across all jobs; it is not a photo-selection limit.
IMPORT_CONCURRENCY=4
IMPORT_BATCH_SIZE=100
IMPORT_MAX_ATTEMPTS=5
IMPORT_RETRY_BASE_MS=1000
# Byte limits: 20 GiB stored media, 128 MiB free reserve, 100 MiB per image.
STORAGE_QUOTA_BYTES=21474836480
MIN_FREE_DISK_BYTES=134217728
MAX_IMAGE_BYTES=104857600

# P3 — server-only Gemini access (separate from Google Photos OAuth).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_OUTPUT_TOKENS=12288
# USD per million tokens; verify current prices when changing model or tier.
GEMINI_INPUT_PRICE_PER_MILLION=0.30
GEMINI_OUTPUT_PRICE_PER_MILLION=2.50
# Shared estimated-spend cap for photo analysis, retries and storyboards per project.
GEMINI_MAX_PROJECT_SPEND_USD=10
ANALYSIS_CONCURRENCY=2
ANALYSIS_BATCH_SIZE=20
ANALYSIS_MAX_ATTEMPTS=5
ANALYSIS_RETRY_BASE_MS=1000
ANALYSIS_PIPELINE_VERSION=photo-v1
ANALYSIS_IMAGE_MAX_DIMENSION=1024
ANALYSIS_NEAR_DUPLICATE_DISTANCE=5

# P4 — official Gemini Interactions API. No paid work starts without an approved quote.
VIDEO_PROVIDER=omni
# User-selected stable baseline. 1.2 is documented GA but account access is unverified.
OMNI_MODEL=gemini-omni-1.1-flash
# Reserved for a future Google Cloud Veo adapter; Veo previews in Gemini API are retired.
VEO_MODEL=veo-3.1-fast-generate-001
VIDEO_RESOLUTION=720p
VIDEO_ASPECT_RATIO=16:9
VIDEO_DURATION_SECONDS=8
VIDEO_MAX_CONCURRENT_JOBS=1
VIDEO_MAX_PROJECT_BUDGET_USD=10
VIDEO_MAX_AUTOMATIC_RETRIES=1
VIDEO_POLL_INTERVAL_MS=10000
VIDEO_REQUEST_TIMEOUT_MS=60000
VIDEO_MAX_BYTES=536870912
VIDEO_KEYFRAME_MODEL=gemini-3.1-flash-image
VIDEO_QUALITY_MODEL=gemini-3.5-flash-lite
# Conservative per-stage estimates, not confirmed provider charges.
VIDEO_KEYFRAME_ESTIMATE_USD=0.25
VIDEO_QUALITY_ESTIMATE_USD=0.05
# Optional overrides. Platform-specific FFmpeg/ffprobe binaries are bundled via npm.
FFMPEG_PATH=
FFPROBE_PATH=

# P5 local movie assembly; no paid provider is used by the renderer.
MOVIE_THREADS=2
MOVIE_MEMORY_LIMIT_MB=1024
MOVIE_MAX_WORKSPACE_BYTES=4294967296
MOVIE_MAX_OUTPUT_BYTES=1073741824
MOVIE_MAX_SOUNDTRACK_BYTES=104857600
MOVIE_RENDER_TIMEOUT_MS=3600000
MOVIE_DURATION_TOLERANCE_SECONDS=0.15
# Optional absolute paths to Unicode fonts; OS fonts are detected by default.
MOVIE_FONT_SERIF_PATH=
MOVIE_FONT_SANS_PATH=

# P6 orchestrator. Opening the UI or requesting a quote never starts paid work.
PRODUCTION_DEFAULT_BUDGET_USD=20
PRODUCTION_POLL_INTERVAL_MS=1000
PRODUCTION_MAX_STAGE_ATTEMPTS=2

# P6.1 cinematic preferences and moment edits persist in the existing SQLite DB.
# No additional API keys are required. Existing Omni/model/budget limits remain in force.
# For multilingual Pango/HarfBuzz captions, existing MOVIE_FONT_* paths must point to Unicode fonts.
